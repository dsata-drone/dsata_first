# ============================================================
# AIオフィス自律運転の環境変数(GitHub Actions では Secrets に設定)
# ローカル実行時は `set -a; source automation/config.env; set +a` などで読み込む
# ※ このファイルを config.env にコピーして値を入れる。config.env はコミットしないこと
# ============================================================

# --- 采配ブレーン(任意。未設定ならルールベース采配で動く) ---
# https://platform.claude.com/ で発行
ANTHROPIC_API_KEY=

# --- Slack通知(任意) ---
# Slackアプリ → Incoming Webhooks で発行。通常通知用
SLACK_WEBHOOK_URL=
# 緊急通知(人間の判断が必要な時)用。別チャンネル推奨。未設定なら通常用を使う
EMERGENCY_SLACK_WEBHOOK_URL=

# --- メール送信(任意。外注依頼書などの自動送付に必要) ---
# 例: Gmailなら SMTP_HOST=smtp.gmail.com / SMTP_PORT=587 / SMTP_PASS=アプリパスワード
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# GITHUB_TOKEN は GitHub Actions が自動注入(ローカルでは通常不要)
